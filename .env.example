# Map search provider — set ONE of these two:
# Serper.dev  (cheaper, ~$0.001/search): https://serper.dev
SERPER_API_KEY=your-serper-api-key
# SerpAPI     (alternative):             https://serpapi.com
# SERPAPI_KEY=your-serpapi-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Railway service
WA_SERVICE_URL=https://your-app.up.railway.app
WA_SERVICE_SECRET=change-me-to-a-long-random-string

# Outreach message — {{name}} is replaced at send time
MESSAGE_TEMPLATE=Bonjour {{name}},\n\nJ'ai pris l'initiative de concevoir un site web premium spécialement pour votre entreprise.\n\nJe peux vous envoyer gratuitement un lien de prévisualisation, sans aucun engagement. S'il vous plaît, vous pourrez l'acquérir. Sinon, vous n'avez rien à payer.\n\nSouhaitez-vous recevoir le lien de prévisualisation ?

# Sending window (24h format, local to each campaign's timezone)
SEND_START_HOUR=8
SEND_END_HOUR=18

# Vercel cron protection
CRON_SECRET=change-me-to-another-long-random-string
